# Non-secret GCP deployment identifiers. Copy to .env.gcp (gitignored).
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
GCP_ARTIFACT_REPO=telegram-bots
GCP_SERVICE_NAME=grammy-bot
GCP_WORKER_POOL=grammy-worker
GCP_MIGRATE_JOB=grammy-db-migrate
GCP_SQL_CONNECTION_NAME=your-gcp-project-id:europe-west1:grammy-postgres
GCP_RUN_SERVICE_ACCOUNT=grammy-runtime@your-gcp-project-id.iam.gserviceaccount.com
GCP_VPC_NETWORK=default
GCP_VPC_SUBNET=default
GCP_ADMIN_TELEGRAM_ID=123456789
# Names of EXISTING Secret Manager secrets. Never place their values in this file.
GCP_BOT_TOKEN_SECRET=grammy-bot-token
GCP_DATABASE_URL_SECRET=grammy-database-url
GCP_WEBHOOK_SECRET_SECRET=grammy-webhook-secret
GCP_REDIS_URL_SECRET=grammy-redis-url
GCP_REDIS_ENABLED=0
GCP_METRICS_TOKEN_SECRET=grammy-metrics-token
GCP_METRICS_TOKEN_VERSION=1
# Optional monitoring secret; omitted values preserve existing configured secrets.
# GCP_SENTRY_DSN_SECRET=grammy-sentry-dsn
# GCP_SENTRY_DSN_VERSION=1
# GCP_SUPPORT_CONTACT=@your_support
# GCP_PRIVACY_POLICY_URL=https://example.com/privacy
# First creation only, before registering Telegram webhook. Turn off after bootstrap.
GCP_BOOTSTRAP=0

# Production: pin numeric Secret Manager versions to avoid surprises on new revisions.
GCP_BOT_TOKEN_VERSION=1
GCP_DATABASE_URL_VERSION=1
GCP_WEBHOOK_SECRET_VERSION=1
GCP_REDIS_URL_VERSION=1

# Strongly recommended in production: use a separate DB migration identity / DDL-only URL.
# If omitted, the runtime account and DATABASE_URL secret will be reused.
# GCP_MIGRATOR_SERVICE_ACCOUNT=grammy-migrator@your-gcp-project-id.iam.gserviceaccount.com
# GCP_MIGRATION_DATABASE_URL_SECRET=grammy-migration-database-url
# GCP_MIGRATION_DATABASE_URL_VERSION=1

# Non-secret runtime policy; 0 disables feedback auto-deletion.
GCP_RATE_LIMIT_PER_MINUTE=0
GCP_FEEDBACK_RETENTION_DAYS=0
