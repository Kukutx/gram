# Obtain a real bot token from https://t.me/BotFather
BOT_TOKEN=123456789:replace_with_your_bot_token
BOT_MODE=polling
PORT=3000
LOG_LEVEL=info
WEBHOOK_PATH=/telegram/webhook
# Default 1 reduces concurrency; command receipts still protect replay and stale state updates.
WEBHOOK_MAX_CONNECTIONS=1
# For webhook mode, generate via: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
WEBHOOK_SECRET=
# PUBLIC_URL=https://your-cloud-run-hostname.run.app
DATABASE_URL=postgresql://bot:bot_password@127.0.0.1:5432/grammy_bot?schema=public
# Optional: enables reliable notifications (start the separate Worker)
REDIS_URL=
# To enable the optional queue accelerator: REDIS_URL=redis://127.0.0.1:6379
# Optional numeric Telegram ID; required for admin commands and notification worker
# ADMIN_TELEGRAM_ID=123456789
# Optional Sentry error monitoring
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional bearer token to enable private /metrics endpoint
# METRICS_TOKEN=replace_with_a_long_random_token

# User requests allowed per minute (0 disables). Redis enables cross-instance enforcement.
RATE_LIMIT_PER_MINUTE=0
# 0 = no automatic feedback deletion. Nonzero is a deliberate irreversible policy.
# Run the separate Worker even without Redis/admin; it also performs maintenance.
FEEDBACK_RETENTION_DAYS=0

# Public contact for privacy/data requests and optional full policy.
# SUPPORT_CONTACT=@your_support
# PRIVACY_POLICY_URL=https://example.com/privacy
