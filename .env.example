# ── Required ────────────────────────────────────────────────────────────────
# Bot token from https://t.me/BotFather
BOT_TOKEN=123456789:replace_with_your_bot_token
DATABASE_URL=postgresql://bot:bot_password@127.0.0.1:5432/grammy_bot?schema=public

# ── Docker Compose deployment (deploy/compose.yaml, see docs/DEPLOY.md) ───────
# Password of the bundled PostgreSQL; the containers build DATABASE_URL from it.
POSTGRES_PASSWORD=
# Use a managed database instead of the bundled one.
# EXTERNAL_DATABASE_URL=postgresql://user:password@host:5432/db
# Webhook mode only: public domain served by the bundled Caddy (ports 80/443).
# DOMAIN=bot.example.com

# ── Support team ────────────────────────────────────────────────────────────
# Telegram user IDs (comma or space separated) allowed to run admin commands.
# Without ADMIN_CHAT_ID each of them also gets ticket notifications privately.
# Find your ID by sending /id to the bot.
ADMIN_IDS=
# Optional support group (negative ID, send /id in the group). When set, notifications
# go to this group and EVERY member can answer tickets there: only add trusted staff.
# Make the bot an administrator of the group so it sees plain replies.
# ADMIN_CHAT_ID=-1001234567890
# In a forum-enabled supergroup, open one topic per ticket (bot needs "Manage topics").
ADMIN_USE_TOPICS=false
# command: users send /feedback first; direct: every private message reaches support.
INTAKE_MODE=command
# Tell users when their ticket is resolved, closed or reopened.
NOTIFY_USER_ON_STATUS=true

# ── Runtime ─────────────────────────────────────────────────────────────────
BOT_MODE=polling
PORT=3000
LOG_LEVEL=info
# Language for users without a preference and for staff notifications: zh | en
DEFAULT_LANGUAGE=zh

# Webhook mode only. Generate the secret with:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram/webhook
# PUBLIC_URL=https://bot.example.com
# Default 1 keeps updates sequential; receipts still protect replays.
WEBHOOK_MAX_CONNECTIONS=1

# ── Worker (start it in every deployment: it sends all messages) ─────────────
# Parallel sends to different chats; one chat always receives messages in order.
DELIVERY_CONCURRENCY=4
# Fallback scan interval; PostgreSQL LISTEN/NOTIFY wakes the worker immediately.
OUTBOX_POLL_MS=5000
# Set false when DATABASE_URL goes through a transaction-mode pooler (PgBouncer, Supabase pooler).
OUTBOX_LISTEN=true
# Optional /live and /ready probe port for the worker (0 disables).
WORKER_HEALTH_PORT=0

# ── Limits, retention and privacy ───────────────────────────────────────────
# Requests per user per minute (0 disables). Set REDIS_URL to share the limit across instances.
RATE_LIMIT_PER_MINUTE=0
# REDIS_URL=redis://127.0.0.1:6379
# Delete tickets with no activity for this many days (0 keeps them). Irreversible.
FEEDBACK_RETENTION_DAYS=0
# Public contact for privacy/data requests and optional full policy.
# SUPPORT_CONTACT=@your_support
# PRIVACY_POLICY_URL=https://example.com/privacy

# ── Observability ───────────────────────────────────────────────────────────
# Bearer token (24+ chars) that enables /metrics and /ops/health
# METRICS_TOKEN=replace_with_a_long_random_token
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# RELEASE_ID=v2.0.0
